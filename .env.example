# Copy this file to `.env` and put your key in it. `.env` is gitignored: never commit it.

# --- Answers ------------------------------------------------------------------------------
# Free option (what this project was built and verified on): a Google Gemini key from
# https://aistudio.google.com (Create API key, no billing). Gemini speaks the OpenAI protocol,
# so the same code works and only these settings change.
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
# Why the lite model: on the free tier the flagship alias (gemini-flash-latest) allowed 5 requests
# a minute AND a hard daily cap of roughly 20, which ends a real session quickly. The lite models
# took 14 requests back to back without complaint. Quotas are per model; check yours.
# The outputs committed under docs/ were produced with the explicit name gemini-3.5-flash-lite
# (an alias like this one moves over time): set LLM_MODEL to that exact name to replay them.
# The app waits instead of failing, but only if it knows the per-minute limit: set this a little
# below yours. 0 = no limit.
LLM_RPM=12

# Paid option: a real OpenAI key. Leave OPENAI_BASE_URL empty and use
#   OPENAI_API_KEY=sk-...        LLM_MODEL=gpt-4o-mini
#   EMBED_PROVIDER=openai        EMBED_MODEL=text-embedding-3-small
# (and re-ingest: switching the embedding provider changes the vector size.)

# The Week 6 judge. Use a DIFFERENT model from LLM_MODEL (a model tends to like its own family's output).
# Blank = the answer model judges itself. JUDGE_RPM 0 = use LLM_RPM.
JUDGE_MODEL=gemini-3.1-flash-lite
JUDGE_RPM=12

# Week 6 experiments in cleaning the index. Both are off by default, neither raised the score on the eval set
# (docs/week6/CHANGES.md), and changing either needs a re-ingest.
# DEDUPE_CHUNKS=true            drop chunks that are exact copies of an earlier chunk in the same document
# BOILERPLATE_MIN_REPEATS=10    remove lines repeated this many times inside one document before chunking

# --- Embeddings ---------------------------------------------------------------------------
# local  = a small model that runs on THIS machine: free, offline, no quota.
#          Download it once with:  python scripts/download_model.py
# openai = EMBED_MODEL through the API (needs quota). Gemini's free tier allows 100 per minute.
EMBED_PROVIDER=local
EMBED_MODEL=text-embedding-3-small
# Throttle for the API embedding path only (0 = off). For Gemini's free tier use 90.
EMBED_RPM=0

# --- How documents are cut up (Week 3's graded experiment) ---------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Optional safety net: refuse without asking the model if the best chunk scores below this
# (0.0 = off). Tune it after looking at real scores.
MIN_RELEVANCE=0.0

# --- How chunks are found -----------------------------------------------------------------
# dense  = by meaning only. This is the Week 3 behaviour, and what Week 3's checks assume.
# hybrid = meaning + keyword (BM25) search merged with RRF. This is Week 4's one change.
RETRIEVAL_MODE=dense
# exact = compare the question with every stored vector. Always correct; the default.
# ann   = Chroma's approximate index. Faster at huge scale but missed the right chunk on this
#         corpus and differed run to run. Kept so that can be reproduced
#         (python scripts/compare_ann_exact.py).
DENSE_SEARCH=exact
# How many candidates EACH search contributes before merging (hybrid only)
HYBRID_CANDIDATES=10
# RRF damping constant (60 is the value from the paper)
RRF_K=60
# BM25 tuning: k1 = term-frequency saturation, b = length normalisation
BM25_K1=1.5
BM25_B=0.75
# The k in "hit-rate@k" that scripts/eval_retrieval.py highlights
EVAL_K=3

# --- What a token costs (Week 10) ----------------------------------------------------------
# The free tier bills nothing, so a cost is tokens x a price YOU state, in dollars per million tokens, input and
# output priced separately. Look up your provider's current price; this project ships no price table on purpose (it
# would go stale and look like a fact).
# No Week 10 command reads the two settings below. The race report takes its prices only from the command line,
#   python scripts/race_team.py --show LABEL --price-in 0.10 --price-out 0.40 --price-source "where you read them"
# and shows tokens only, saying so, when you state none. The settings are just the default for code that calls
# app.pricing without a price (0 = unpriced); changing them changes nothing in the race report.
PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0

# --- The request log and what the model is shown (Week 11) ---------------------------------
# The request log (data/traces/traces.jsonl) reads the two PRICE_ settings above when a line is written: with a price set each model
# step gets a cost_usd and the prices used, with none it is null (unknown is not free). The report scripts take their prices from the
# command line instead (--price-in, --price-out, --price-source), so one log never prints two different costs.
# Where the request log goes; the log of failed requests, errors.jsonl, sits beside it.
# TRACES_PATH=data/traces/traces.jsonl
# Take out of the passages sent to the model every line that its own document repeats this many times (0 = off). The index and the
# search are untouched, so no re-ingest is needed. docs/week11/prediction.md says what to expect; scripts/estimate_context_savings.py
# screens it for free.
# CONTEXT_STRIP_MIN_REPEATS=10
