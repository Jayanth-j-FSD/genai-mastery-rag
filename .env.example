# Copy this file to `.env` and put your key in it. `.env` is gitignored: never commit it.

# --- Answers ------------------------------------------------------------------------------
# Free option (what this project was built and verified on): a Google Gemini key from
# https://aistudio.google.com (Create API key, no billing). Gemini speaks the OpenAI protocol,
# so the same code works and only these settings change.
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
# The free tier allows about 5 chat requests per minute PER MODEL. The app waits instead of
# failing, but only if it knows the limit: set this a little below yours. 0 = no limit.
LLM_RPM=4

# Paid option: a real OpenAI key. Leave OPENAI_BASE_URL empty and use
#   OPENAI_API_KEY=sk-...        LLM_MODEL=gpt-4o-mini
#   EMBED_PROVIDER=openai        EMBED_MODEL=text-embedding-3-small
# (and re-ingest: switching the embedding provider changes the vector size.)

# --- Embeddings ---------------------------------------------------------------------------
# local  = a small model that runs on THIS machine: free, offline, no quota.
#          Download it once with:  python scripts/download_model.py
# openai = EMBED_MODEL through the API (needs quota). Gemini's free tier allows 100 per minute.
EMBED_PROVIDER=local
EMBED_MODEL=text-embedding-3-small
# Throttle for the API embedding path only (0 = off). For Gemini's free tier use 90.
EMBED_RPM=0

# --- How documents are cut up (Week 3's graded experiment) ---------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Optional safety net: refuse without asking the model if the best chunk scores below this
# (0.0 = off). Tune it after looking at real scores.
MIN_RELEVANCE=0.0

# --- How chunks are found -----------------------------------------------------------------
# dense  = by meaning only. This is the Week 3 behaviour, and what Week 3's checks assume.
# hybrid = meaning + keyword (BM25) search merged with RRF. This is Week 4's one change.
RETRIEVAL_MODE=dense
# exact = compare the question with every stored vector. Always correct; the default.
# ann   = Chroma's approximate index. Faster at huge scale but missed the right chunk on this
#         corpus and differed run to run. Kept so that can be reproduced
#         (python scripts/compare_ann_exact.py).
DENSE_SEARCH=exact
# How many candidates EACH search contributes before merging (hybrid only)
HYBRID_CANDIDATES=10
# RRF damping constant (60 is the value from the paper)
RRF_K=60
# BM25 tuning: k1 = term-frequency saturation, b = length normalisation
BM25_K1=1.5
BM25_B=0.75
# The k in "hit-rate@k" that scripts/eval_retrieval.py highlights
EVAL_K=3
