# Copy this file to `.env` and fill in your key. `.env` is gitignored.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults live in app/config.py)
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Optional safety net: minimum similarity for the best chunk (0.0 = off)
MIN_RELEVANCE=0.0

# --- Week 4: retrieval strategy ---
# dense  = meaning-only search (exactly the Week 3 behaviour)
# hybrid = meaning search + keyword (BM25) search, merged with RRF
RETRIEVAL_MODE=hybrid
# How many candidates EACH search contributes before merging
HYBRID_CANDIDATES=10
# RRF damping constant (60 is the value from the paper)
RRF_K=60
# BM25 tuning: k1 = term-frequency saturation, b = length normalisation
BM25_K1=1.5
BM25_B=0.75
# The k in "hit-rate@k" that scripts/eval_retrieval.py highlights
EVAL_K=3
